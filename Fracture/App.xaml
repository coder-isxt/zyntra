<Application x:Class="Fracture.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fracture"
             xmlns:conv="clr-namespace:Fracture.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisConverter" />
            <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisConverter" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisConverter" />
            <conv:ExeIconConverter x:Key="ExeIconConverter" />
            <conv:ExeHasIconToVisibilityConverter x:Key="ExeHasIconVis" />
            <conv:ExeHasIconToInverseVisibilityConverter x:Key="ExeNoIconVis" />
            <conv:NonZeroToVisibilityConverter x:Key="NonZeroToVisConverter" />
            <conv:FirstCharConverter x:Key="FirstCharConverter" />
            <conv:YouTubeThumbnailConverter x:Key="YouTubeThumbnailConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
