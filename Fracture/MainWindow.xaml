<Window x:Class="Fracture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fracture"
        xmlns:vm="clr-namespace:Fracture.ViewModels"
        xmlns:views="clr-namespace:Fracture.Views"
        mc:Ignorable="d"
        Title="Fracture" Icon="logo.ico" Height="650" Width="1000" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource MainBrush}" CornerRadius="14"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            Effect="{StaticResource PopupShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TopBrush}"
                    CornerRadius="14,14,0,0" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLogo}" Stroke="{StaticResource AccentGradientBrush}"
                              StrokeThickness="2.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,10,0" />
                        <TextBlock Text="Fracture" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="·" Foreground="{StaticResource SubTextBrush}" FontSize="13"
                                   Margin="8,0" VerticalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="{Binding CurrentPageName}" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Notification Bell -->
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Command="{Binding ToggleNotificationsCommand}" ToolTip="Notifications">
                            <Grid Width="14" Height="14">
                                <Path Data="{StaticResource IconBell}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" />
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{StaticResource AccentGradientBrush}"
                                        BorderBrush="{StaticResource TopBrush}" BorderThickness="1.5"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                        Visibility="{Binding UnreadNotifications, Converter={StaticResource NonZeroToVisConverter}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeClick" ToolTip="Minimize">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeClick" ToolTip="Maximize">
                            <Path Data="{StaticResource IconMaximize}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseClick" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation -->
                        <StackPanel Grid.Row="0" Margin="0,10">
                            <TextBlock Text="NAVIGATION" Style="{StaticResource SectionHeaderStyle}"
                                       Margin="18,6,0,6" />

                            <Button x:Name="BtnDashboard"
                                    Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Click="SidebarNav_Click" Tag="Dashboard"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource SidebarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDashboard}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeLineJoin="Round"
                                          Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnApps"
                                    Command="{Binding NavigateCommand}" CommandParameter="Apps"
                                    Click="SidebarNav_Click" Tag="Apps"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource SidebarButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconApps}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeLineJoin="Round"
                                          Width="17" Height="17" Stretch="Uniform" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="Apps" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" CornerRadius="9" Background="{StaticResource ControlBrush}"
                                            Padding="6,1" MinWidth="20" Margin="6,0,0,0"
                                            Visibility="{Binding DataContext.ShowSidebarBadges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding DataContext.AppCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10" Foreground="{StaticResource SubTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnRoblox"
                                    Command="{Binding NavigateCommand}" CommandParameter="Roblox"
                                    Click="SidebarNav_Click" Tag="Roblox"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource SidebarActiveButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconAccounts}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"
                                          Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="Accounts" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" CornerRadius="9" Background="{StaticResource ControlBrush}"
                                            Padding="6,1" MinWidth="20" Margin="6,0,0,0"
                                            Visibility="{Binding DataContext.ShowSidebarBadges, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding DataContext.AccountCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10" Foreground="{StaticResource SubTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>

                            <TextBlock Text="TOOLS" Style="{StaticResource SectionHeaderStyle}"
                                       Margin="18,16,0,6" />

                            <Button x:Name="BtnFastFlags"
                                    Command="{Binding NavigateCommand}" CommandParameter="FastFlags"
                                    Click="SidebarNav_Click" Tag="FastFlags"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource SidebarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFlag}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="FastFlags" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnActivity"
                                    Command="{Binding NavigateCommand}" CommandParameter="Activity"
                                    Click="SidebarNav_Click" Tag="Activity"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource SidebarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconActivity}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Activity Log" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!-- Footer -->
                        <StackPanel Grid.Row="1">
                            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                                <Button x:Name="BtnSettings"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                        Click="SidebarNav_Click" Tag="Settings"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SidebarButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSettings}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"
                                              Margin="0,0,12,0" />
                                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                                    Padding="18,10">
                                <TextBlock x:Name="VersionText" FontSize="11"
                                           Foreground="{StaticResource SubTextBrush}" Opacity="0.4" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Border Background="{StaticResource PanelBrush}">
                        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                                    <views:DashboardView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:AppsViewModel}">
                                    <views:AppsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:RobloxAccountsViewModel}">
                                    <views:RobloxAccountsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:FastFlagsViewModel}">
                                    <views:FastFlagsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ActivityLogViewModel}">
                                    <views:ActivityLogView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                    <views:SettingsView />
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </Border>

                    <!-- Toast Notifications Overlay -->
                    <ItemsControl ItemsSource="{Binding Toasts}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,14,14" IsHitTestVisible="False" Width="300">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Message}" FontSize="11"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="40" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Notification Panel Overlay -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="320" MaxHeight="400" Margin="0,4,8,0"
                            Background="{StaticResource CardBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            Effect="{StaticResource PopupShadow}"
                            Visibility="{Binding NotificationPanelOpen, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="14,10">
                                <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <Button Content="Clear all" HorizontalAlignment="Right" Padding="8,3"
                                        Style="{StaticResource ControlButtonStyle}" FontSize="11"
                                        Command="{Binding ClearNotificationsCommand}" />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}"
                                     Style="{StaticResource DarkListBoxStyle}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch" MaxHeight="340">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Message}" FontSize="11"
                                                       Foreground="{StaticResource SubTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="10"
                                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
