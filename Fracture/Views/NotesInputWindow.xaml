<Window x:Class="Fracture.Views.NotesInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Note" Height="280" Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border Background="{StaticResource MainBrush}" CornerRadius="14"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            Effect="{StaticResource PopupShadow}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" Text="Note" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />

            <TextBlock Grid.Row="2" Text="Private note stored with this account (password reminder, email, etc.)"
                       FontSize="11" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />

            <TextBox x:Name="NotesInput" Grid.Row="4"
                     Style="{StaticResource DarkTextBoxStyle}" Tag="Type a note..."
                     FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Clear" Style="{StaticResource ControlButtonStyle}"
                        Click="OnClearClick" Padding="14,8" Margin="0,0,8,0" />
                <Button Content="Cancel" Style="{StaticResource ControlButtonStyle}"
                        Click="OnCancelClick" Padding="14,8" Margin="0,0,8,0" />
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClick" Padding="20,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
