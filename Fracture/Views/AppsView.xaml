<UserControl x:Class="Fracture.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fracture.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Applications" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Manage your built-in and custom applications" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ Add App" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding AddAppCommand}" VerticalAlignment="Top" />
        </Grid>

        <!-- Search Bar + View Toggle -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}" Tag="🔍  Search applications..."
                     FontSize="13" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAppListView" Content="≡" FontSize="16" Padding="8,4" ToolTip="List view"
                        Click="OnListViewClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnAppGridView" Content="⊞" FontSize="16" Padding="8,4" Margin="4,0,0,0" ToolTip="Grid view"
                        Click="OnGridViewClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- App List (List View) -->
        <ListBox x:Name="AppListBox" Grid.Row="4" ItemsSource="{Binding FilteredApps}"
                 Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVisConverter}}"
                 SelectedItem="{Binding SelectedApp}"
                 Style="{StaticResource DarkListBoxStyle}"
                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="AppList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="AppList_PreviewMouseMove"
                 Drop="AppList_Drop"
                 DragOver="AppList_DragOver">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Drag Grip -->
                        <TextBlock Grid.Column="0" Text="⠿" FontSize="16"
                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.4"
                                   VerticalAlignment="Center" Margin="0,0,6,0" Cursor="SizeAll" />

                        <!-- Icon -->
                        <Grid Grid.Column="1" Width="36" Height="36" VerticalAlignment="Center">
                            <!-- Fallback letter -->
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{StaticResource ControlBrush}">
                                <TextBlock Text="{Binding Name[0]}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Custom icon (if IconPath set) -->
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource ControlBrush}" Padding="4"
                                    Visibility="{Binding IconPath, Converter={StaticResource ExeHasIconVis}}">
                                <Image Source="{Binding IconPath, Converter={StaticResource ExeIconConverter}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <!-- Exe icon (if no custom icon) -->
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource ControlBrush}" Padding="4"
                                    Visibility="{Binding IconPath, Converter={StaticResource ExeNoIconVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExePath, Converter={StaticResource ExeHasIconVis}}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding ExePath, Converter={StaticResource ExeIconConverter}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <!-- Name + Description -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <Border Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisConverter}}"
                                        Background="{StaticResource AccentGradientBrush}" CornerRadius="4"
                                        Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Built-in" FontSize="10" FontWeight="Bold" Foreground="#FF0D1117" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="12"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Launch -->
                        <Button Grid.Column="3" Content="Launch"
                                Style="{StaticResource AccentButtonStyle}" Padding="14,7"
                                Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" VerticalAlignment="Center" />

                        <!-- Settings -->
                        <Button Grid.Column="5" Content="⚙" FontSize="15" Padding="8,5"
                                Style="{StaticResource ControlButtonStyle}" VerticalAlignment="Center"
                                ToolTip="App settings"
                                Command="{Binding DataContext.EditAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />

                        <!-- Remove -->
                        <Button Grid.Column="7"
                                Content="✕" FontSize="14" Padding="8,4"
                                Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"
                                ToolTip="Remove app"
                                Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- App Grid (Grid View) -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisConverter}}">
            <ItemsControl ItemsSource="{Binding FilteredApps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150" Height="150" Style="{StaticResource CardInteractiveStyle}"
                                Padding="0" Margin="4" MouseLeftButtonUp="OnGridCardLaunchApp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon area -->
                                <Grid Grid.Row="0" Width="52" Height="52" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Fallback letter -->
                                    <Border Width="52" Height="52" CornerRadius="12"
                                            Background="{StaticResource ControlBrush}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                                                   FontSize="24" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Custom icon -->
                                    <Border Width="52" Height="52" CornerRadius="12"
                                            Background="{StaticResource ControlBrush}" Padding="6"
                                            Visibility="{Binding IconPath, Converter={StaticResource ExeHasIconVis}}">
                                        <Image Source="{Binding IconPath, Converter={StaticResource ExeIconConverter}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <!-- Exe icon -->
                                    <Border Width="52" Height="52" CornerRadius="12"
                                            Background="{StaticResource ControlBrush}" Padding="6"
                                            Visibility="{Binding IconPath, Converter={StaticResource ExeNoIconVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExePath, Converter={StaticResource ExeHasIconVis}}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding ExePath, Converter={StaticResource ExeIconConverter}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>

                                <!-- Name + badge -->
                                <StackPanel Grid.Row="1" Margin="8,0,8,10" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" MaxWidth="130" />
                                    <Border CornerRadius="4" Padding="6,1" Margin="0,3,0,0"
                                            Background="{StaticResource AccentGradientBrush}"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Built-in" FontSize="9" FontWeight="Bold" Foreground="#FF0D1117" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock Grid.Row="4" Text="No applications found. Click '+ Add App' to get started."
                   Foreground="{StaticResource SubTextBrush}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Apps.Count, Converter={StaticResource ZeroToVisConverter}}" />
    </Grid>
</UserControl>
