<Window x:Class="Fracture.Views.LaunchPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fracture — Launch Roblox" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border Background="{StaticResource MainBrush}" CornerRadius="14"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            Effect="{StaticResource PopupShadow}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}">
                <Run Text="Launch Roblox as " />
                <Run x:Name="AccountNameRun" Foreground="{StaticResource AccentBrush}" />
            </TextBlock>

            <!-- Label -->
            <TextBlock Grid.Row="2" Text="Enter a Place ID to join a specific game, or pick a recent one."
                       FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />

            <!-- Place ID Input -->
            <TextBox x:Name="PlaceIdInput" Grid.Row="4"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Tag="Place ID (e.g. 4483381587)" FontSize="13" />

            <!-- Buttons -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="▶ Join Game" Style="{StaticResource AccentButtonStyle}"
                        Click="OnJoinGameClick" />
                <Button Grid.Column="2" Content="Just Launch" Style="{StaticResource ControlButtonStyle}"
                        Click="OnJustLaunchClick" />
                <Button Grid.Column="4" Content="Cancel" Style="{StaticResource ControlButtonStyle}"
                        Click="OnCancelClick" Padding="16,10" />
            </Grid>

            <!-- Favorite Games -->
            <StackPanel x:Name="FavoritesPanel" Grid.Row="7" Margin="0,14,0,0"
                        Visibility="Collapsed">
                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="FAVORITES" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="FavoritesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardInteractiveStyle}"
                                            Padding="10,8" Margin="0,2"
                                            MouseLeftButtonUp="OnFavoriteGameClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⭐" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding GameName}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding PlaceId}" FontSize="11"
                                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Recently Played -->
            <StackPanel x:Name="RecentPanel" Grid.Row="8" Margin="0,10,0,0"
                        Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardInteractiveStyle}"
                                        Padding="10,8" Margin="0,2"
                                        MouseLeftButtonUp="OnRecentGameClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎮" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding GameName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding PlaceId}" FontSize="11"
                                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Button Grid.Column="4" Content="⭐" FontSize="11" Padding="4,2"
                                                Style="{StaticResource ControlButtonStyle}" Margin="6,0,0,0"
                                                ToolTip="Add to favorites" Click="OnAddToFavorites" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
