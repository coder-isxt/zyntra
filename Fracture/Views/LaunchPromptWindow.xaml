<Window x:Class="Fracture.Views.LaunchPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fracture — Launch Roblox" SizeToContent="Height" Width="440"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border Background="{StaticResource MainBrush}" CornerRadius="14"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            Effect="{StaticResource PopupShadow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Title -->
                <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}">
                    <Run Text="Launch Roblox as " />
                    <Run x:Name="AccountNameRun" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>

                <!-- Join a game by Place ID -->
                <TextBlock Text="JOIN A GAME" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,6" />
                <TextBlock Text="Enter a Place ID to join a specific game, or pick a recent one below."
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBox x:Name="PlaceIdInput"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Tag="Place ID (e.g. 4483381587)" FontSize="13" />
                <Button Content="▶ Join Game" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left" Padding="18,8" Margin="0,8,0,0"
                        Click="OnJoinGameClick" />

                <!-- Join a specific server (JobId) -->
                <TextBlock Text="JOIN A SPECIFIC SERVER" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,6" />
                <TextBlock Text="Paste a Place ID and a Server (Job) ID to join an exact server instance."
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBox x:Name="ServerPlaceIdInput"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Tag="Place ID" FontSize="13" Margin="0,0,0,8" />
                <TextBox x:Name="ServerJobIdInput"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Tag="Server / Job ID (GUID)" FontSize="13" />
                <Button Content="Join Server" Style="{StaticResource ControlButtonStyle}"
                        HorizontalAlignment="Left" Padding="18,8" Margin="0,8,0,0"
                        Click="OnJoinServerClick" />

                <!-- Follow a player -->
                <TextBlock Text="FOLLOW A PLAYER" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,6" />
                <TextBlock Text="Enter a username to join the server they're currently playing in (if their join settings allow it)."
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBox x:Name="UsernameInput"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Tag="Username to follow" FontSize="13" />
                <Button Content="Join User" Style="{StaticResource ControlButtonStyle}"
                        HorizontalAlignment="Left" Padding="18,8" Margin="0,8,0,0"
                        Click="OnJoinUserClick" />

                <!-- Just launch / cancel -->
                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                        Margin="0,18,0,0" Padding="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Just Launch (no game)" Style="{StaticResource ControlButtonStyle}"
                                Padding="16,10" Click="OnJustLaunchClick" />
                        <Button Content="Cancel" Style="{StaticResource ControlButtonStyle}"
                                Padding="16,10" Margin="8,0,0,0" Click="OnCancelClick" />
                    </StackPanel>
                </Border>

                <!-- Favorite Games -->
                <StackPanel x:Name="FavoritesPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="FAVORITES" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                    <ItemsControl x:Name="FavoritesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardInteractiveStyle}"
                                        Padding="10,8" Margin="0,2"
                                        MouseLeftButtonUp="OnFavoriteGameClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⭐" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding GameName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding PlaceId}" FontSize="11"
                                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Recently Played -->
                <StackPanel x:Name="RecentPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardInteractiveStyle}"
                                        Padding="10,8" Margin="0,2"
                                        MouseLeftButtonUp="OnRecentGameClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎮" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding GameName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding PlaceId}" FontSize="11"
                                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Button Grid.Column="4" Content="⭐" FontSize="11" Padding="4,2"
                                                Style="{StaticResource ControlButtonStyle}" Margin="6,0,0,0"
                                                ToolTip="Add to favorites" Click="OnAddToFavorites" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
