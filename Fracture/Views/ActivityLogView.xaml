<UserControl x:Class="Fracture.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Activity Log" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="A history of launches, play sessions, and account changes."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Content="Clear log" Style="{StaticResource DangerButtonStyle}" Padding="16,8"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding ClearCommand}" />
        </Grid>

        <!-- Log list -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVisConverter}}">
                    <TextBlock Text="🗒️" FontSize="40" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="No activity yet" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="Launch an account to start recording activity."
                               FontSize="12" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="2,2"
                                        Background="{StaticResource CardBrush}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Message}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.7"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Detail, Converter={StaticResource NonEmptyToVisConverter}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="11"
                                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
