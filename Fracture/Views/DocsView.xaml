<UserControl x:Class="Fracture.Views.DocsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fracture.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Documentation" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Lua scripting API reference and plugin development guide" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Tab Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="BtnOverview" Content="Overview" Padding="18,8"
                    Style="{StaticResource PillButtonActiveStyle}"
                    Click="OnDocNav" Tag="overview" FontSize="12" Margin="0,0,8,0" />
            <Button x:Name="BtnLuaApi" Content="Lua API Reference" Padding="18,8"
                    Style="{StaticResource PillButtonStyle}"
                    Click="OnDocNav" Tag="lua" FontSize="12" Margin="0,0,8,0" />
            <Button x:Name="BtnScriptUI" Content="Script UI API" Padding="18,8"
                    Style="{StaticResource PillButtonStyle}"
                    Click="OnDocNav" Tag="scriptui" FontSize="12" />
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel x:Name="DocPanel" Margin="28,24,28,28" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
