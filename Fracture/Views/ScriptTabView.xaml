<UserControl x:Class="Fracture.Views.ScriptTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TabTitle" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Script-generated tab" FontSize="13"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Dynamic content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" />
        </ScrollViewer>
    </Grid>
</UserControl>
