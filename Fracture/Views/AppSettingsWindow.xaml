<Window x:Class="Fracture.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fracture — App Settings" Height="500" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border Background="{StaticResource MainBrush}" CornerRadius="14"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            Effect="{StaticResource PopupShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TopBrush}"
                    CornerRadius="14,14,0,0" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock x:Name="TitleText" Text="App Settings" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyle}" Click="OnCancelClick" />
                </Grid>
            </Border>

            <!-- Form -->
            <Grid Grid.Row="1" Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Name -->
                        <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="NameInput"
                                 Style="{StaticResource DarkTextBoxStyle}" Tag="Application name" />

                        <!-- Description -->
                        <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,4" />
                        <TextBox x:Name="DescInput"
                                 Style="{StaticResource DarkTextBoxStyle}" Tag="Short description (optional)" />

                        <!-- Exe Path -->
                        <TextBlock Text="Executable Path" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExePathInput" Grid.Column="0"
                                     Style="{StaticResource DarkTextBoxStyle}" Tag="Path to .exe"
                                     FontFamily="Consolas" FontSize="12" />
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource ControlButtonStyle}"
                                    Click="OnBrowseExeClick" />
                        </Grid>

                        <!-- Custom Icon -->
                        <TextBlock Text="Custom Icon (optional)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IconPathInput" Grid.Column="0"
                                     Style="{StaticResource DarkTextBoxStyle}" Tag="Path to icon (.ico, .png, .exe)"
                                     FontFamily="Consolas" FontSize="12" />
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource ControlButtonStyle}"
                                    Click="OnBrowseIconClick" />
                            <Button Grid.Column="4" Content="Clear" Style="{StaticResource ControlButtonStyle}"
                                    Click="OnClearIconClick" />
                        </Grid>

                        <!-- Game Module Toggle -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Game Module" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubTextBrush}" />
                                <TextBlock Text="Enable custom launch args, env vars, and working directory"
                                           FontSize="10" Foreground="{StaticResource SubTextBrush}" Opacity="0.6" />
                            </StackPanel>
                            <CheckBox x:Name="GameModuleToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="OnGameModuleToggled" Unchecked="OnGameModuleToggled" />
                        </Grid>

                        <!-- Game Module Fields (shown when toggle is on) -->
                        <StackPanel x:Name="GameModulePanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Launch Arguments" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="LaunchArgsInput" Style="{StaticResource DarkTextBoxStyle}"
                                     Tag="e.g. --fullscreen --fps=60" FontFamily="Consolas" FontSize="12" />

                            <TextBlock Text="Environment Variables" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,4" />
                            <TextBox x:Name="EnvVarsInput" Style="{StaticResource DarkTextBoxStyle}"
                                     Tag="KEY=VALUE, one per line" FontFamily="Consolas" FontSize="12"
                                     AcceptsReturn="True" Height="50" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock Text="Working Directory" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,4" />
                            <TextBox x:Name="WorkDirInput" Style="{StaticResource DarkTextBoxStyle}"
                                     Tag="Leave empty for exe directory" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Buttons (always visible at bottom) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource ControlButtonStyle}"
                            Click="OnCancelClick" Padding="18,10" Margin="0,0,10,0" />
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                            Click="OnSaveClick" Padding="24,10" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
