<Window x:Class="Fracture.Views.BrowserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fracture — Roblox Login" Height="700" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border Background="{StaticResource MainBrush}" CornerRadius="14"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            Effect="{StaticResource PopupShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TopBrush}"
                    CornerRadius="14,14,0,0" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Roblox Login" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyle}" Click="CloseClick" />
                </Grid>
            </Border>

            <!-- Info Banner -->
            <Border Grid.Row="1" Background="{StaticResource PanelInsetBrush}" Padding="14,10"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Log in to your Roblox account below." FontSize="12"
                               Foreground="{StaticResource SubTextBrush}" />
                    <TextBlock x:Name="StatusLabel" Text="" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- WebView2 Browser -->
            <wv2:WebView2 x:Name="LoginWebView" Grid.Row="2"
                          DefaultBackgroundColor="#15181F" />

            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay" Grid.Row="2" Background="{StaticResource MainBrush}"
                    Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Loading..." FontSize="16" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Preparing login page..." FontSize="12"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
