<UserControl x:Class="Fracture.Views.YouTubePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="YouTubeNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="YouTubeNavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource YouTubeNavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="Foreground" Value="#FF0D1117" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TopIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SmallActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource MainBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="24" CornerRadius="7" Background="#FFFF0033">
                        <Path Data="M10 6l12 6-12 6V6z" Fill="White"
                              Width="15" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="YouTube" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Height="42" MaxWidth="640" CornerRadius="21"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Background="{StaticResource CardBrush}"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding VideoInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Tag="Search or paste a YouTube link"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13" Height="40" Padding="18,7" />
                        <Button Grid.Column="1" Command="{Binding LoadVideoCommand}"
                                Style="{StaticResource TopIconButtonStyle}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                ToolTip="Load">
                            <Path Data="M21 21l-4.35-4.35 M10 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16z"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="4" Style="{StaticResource TopIconButtonStyle}"
                        Command="{Binding OpenPipCommand}" ToolTip="Picture in picture">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPictureInPicture}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="PiP" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Content="Stop" Style="{StaticResource TopIconButtonStyle}"
                        Command="{Binding StopCommand}" />
            </Grid>
        </Border>

        <!-- App Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="124" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Internal Navbar -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8" VerticalAlignment="Top">
                <StackPanel>
                    <Button Command="{Binding NavigateSectionCommand}" CommandParameter="Watch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource YouTubeNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWatchSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                        <Setter Property="Foreground" Value="#FF0D1117" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconVideo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0" />
                            <TextBlock Text="Watch" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSectionCommand}" CommandParameter="Continue">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource YouTubeNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsContinueSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                        <Setter Property="Foreground" Value="#FF0D1117" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M21 12a9 9 0 1 1-3-6.7 M21 3v6h-6 M10 8l5 4-5 4z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0" />
                            <TextBlock Text="Continue" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSectionCommand}" CommandParameter="History">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource YouTubeNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistorySection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                        <Setter Property="Foreground" Value="#FF0D1117" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3 3v5h5 M3.05 13a9 9 0 1 0 2.64-6.36 M12 7v5l3 2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0" />
                            <TextBlock Text="History" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSectionCommand}" CommandParameter="Playlists">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource YouTubeNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaylistsSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                        <Setter Property="Foreground" Value="#FF0D1117" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0" />
                            <TextBlock Text="Lists" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Main Section Host -->
            <Grid Grid.Column="2">
                <!-- Watch / Player View -->
                <Grid Visibility="{Binding IsWatchSection, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF0D1117" CornerRadius="12"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            ClipToBounds="True" MinHeight="300" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <wv2:WebView2 x:Name="PlayerWebView" DefaultBackgroundColor="#0D1117" />
                            <Border x:Name="EmptyOverlay" Background="#FF0D1117">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="84" Height="84" CornerRadius="42"
                                            Background="{StaticResource AccentSoftBrush}"
                                            HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconVideo}" Stroke="{StaticResource AccentBrush}"
                                              StrokeThickness="2" StrokeLineJoin="Round"
                                              Width="36" Height="36" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Paste a YouTube link to start watching"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource SubTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentTitle, FallbackValue='No video loaded'}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentVideoId}" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Save to playlist" Height="34" Padding="16,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding AddCurrentToPlaylistCommand}" />
                    </Grid>
                </Grid>

                <!-- Continue View -->
                <ScrollViewer Visibility="{Binding IsContinueSection, Converter={StaticResource BoolToVisConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Continue watching" Style="{StaticResource PageSubtitleStyle}"
                                   FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding ContinueWatching}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="222" Style="{StaticResource CardInteractiveStyle}"
                                            Padding="10" Margin="0,0,14,16">
                                        <StackPanel>
                                            <Border Height="124" CornerRadius="8" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding VideoId, Converter={StaticResource YouTubeThumbnailConverter}}"
                                                           Stretch="UniformToFill" />
                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay, FallbackValue=0}"
                                                                 Maximum="100" Height="4" VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                       MaxHeight="38" Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                       Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,10" />
                                            <Button Content="Resume" Height="32"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- History View -->
                <Grid Visibility="{Binding IsHistorySection, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Watch history" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <Button Content="Clear history" HorizontalAlignment="Right" Height="34"
                                Padding="16,0" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ClearHistoryCommand}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}"
                                            Padding="10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="8" ClipToBounds="True">
                                                <Image Source="{Binding VideoId, Converter={StaticResource YouTubeThumbnailConverter}}"
                                                       Width="132" Height="74" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="Play" Height="32" Padding="14,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Playlists View -->
                <Grid Visibility="{Binding IsPlaylistsSection, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Playlists" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Tag="New playlist"
                                     Width="220" Height="36" FontSize="12" Padding="12,6" />
                            <Button Content="Create" Height="36" Padding="16,0" Margin="8,0,0,0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding CreatePlaylistCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                                      DisplayMemberPath="Name" Style="{StaticResource DarkComboBoxStyle}"
                                      Height="36" />
                            <Button Content="Add current video" Height="34" Margin="0,10,0,0"
                                    Style="{StaticResource ControlButtonStyle}"
                                    Command="{Binding AddCurrentToPlaylistCommand}" />
                            <Button Content="Delete playlist" Height="34" Margin="0,8,0,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeletePlaylistCommand}" />
                        </StackPanel>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedPlaylistItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}"
                                                Padding="10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="8" ClipToBounds="True">
                                                    <Image Source="{Binding VideoId, Converter={StaticResource YouTubeThumbnailConverter}}"
                                                           Width="112" Height="63" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Content="Play" Height="32" Padding="12,0"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            Command="{Binding DataContext.PlayPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remove" Height="32" Padding="12,0" Margin="8,0,0,0"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Command="{Binding DataContext.RemovePlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Watch Rail -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14"
                    Visibility="{Binding IsWatchSection, Converter={StaticResource BoolToVisConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="UP NEXT" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardInteractiveStyle}" Padding="8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding VideoId, Converter={StaticResource YouTubeThumbnailConverter}}"
                                                       Width="96" Height="54" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" MaxHeight="34" />
                                                <Button Content="Play" Height="24" Padding="8,0" FontSize="10"
                                                        Style="{StaticResource ControlButtonStyle}"
                                                        Margin="0,5,0,0" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource MainBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
