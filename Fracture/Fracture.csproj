<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <AssemblyName>Fracture</AssemblyName>
    <RootNamespace>Fracture</RootNamespace>
    <ApplicationIcon>..\fracture-logo.ico</ApplicationIcon>

    <Version>26.6.2</Version>
    <AssemblyVersion>26.6.2.0</AssemblyVersion>
    <FileVersion>26.6.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\fracture-logo.ico" Link="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\fracture_api.lua" />
    <EmbeddedResource Include="Resources\Lua.xshd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
