<Window x:Class="Zyntra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zyntra"
        xmlns:vm="clr-namespace:Zyntra.ViewModels"
        xmlns:views="clr-namespace:Zyntra.Views"
        mc:Ignorable="d"
        Title="Zyntra" Icon="logo.ico" Height="650" Width="1000" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource MainBrush}" CornerRadius="10"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TopBrush}"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Zyntra" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text=" — " Foreground="{StaticResource SubTextBrush}" FontSize="13" />
                        <TextBlock Text="{Binding CurrentPageName}" Foreground="{StaticResource SubTextBrush}" FontSize="13" />
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Notification Bell -->
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Command="{Binding ToggleNotificationsCommand}" ToolTip="Notifications">
                            <Grid>
                                <TextBlock Text="🔔" FontSize="13" />
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,-4,-4,0"
                                        Visibility="{Binding UnreadNotifications, Converter={StaticResource NonZeroToVisConverter}}">
                                    <TextBlock Text="{Binding UnreadNotifications}" FontSize="8" FontWeight="Bold"
                                               Foreground="#FF0D1117" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button Content="─" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeClick" />
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeClick" />
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="CloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation -->
                        <StackPanel Grid.Row="0" Margin="0,8">
                            <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="18,8,0,8" Opacity="0.6" />

                            <Button x:Name="BtnDashboard" Content="◆  Dashboard"
                                    Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Click="SidebarNav_Click" Tag="Dashboard">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarActiveButtonStyle}" />
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnApps" Content="⊞  Applications"
                                    Command="{Binding NavigateCommand}" CommandParameter="Apps"
                                    Click="SidebarNav_Click" Tag="Apps">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnRoblox" Content="◉  Roblox Accounts"
                                    Command="{Binding NavigateCommand}" CommandParameter="Roblox"
                                    Click="SidebarNav_Click" Tag="Roblox">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                </Button.Style>
                            </Button>

                            <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="18,12,0,8" Opacity="0.6" />

                            <Button x:Name="BtnPlugins" Content="⧉  Plugins"
                                    Command="{Binding NavigateCommand}" CommandParameter="Plugins"
                                    Click="SidebarNav_Click" Tag="Plugins">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnScripts" Content="⟐  Scripts"
                                    Command="{Binding NavigateCommand}" CommandParameter="Scripts"
                                    Click="SidebarNav_Click" Tag="Scripts">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnDocs" Content="📄  API Docs"
                                    Command="{Binding NavigateCommand}" CommandParameter="Docs"
                                    Click="SidebarNav_Click" Tag="Docs">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                </Button.Style>
                            </Button>

                        </StackPanel>

                        <!-- Footer -->
                        <StackPanel Grid.Row="1">
                            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                                <Button x:Name="BtnSettings" Content="⚙  Settings"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                        Click="SidebarNav_Click" Tag="Settings">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                    </Button.Style>
                                </Button>
                            </Border>
                            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                                    Padding="14,10">
                                <TextBlock x:Name="VersionText" FontSize="11"
                                           Foreground="{StaticResource SubTextBrush}" Opacity="0.5" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Border Background="{StaticResource PanelBrush}">
                        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                                    <views:DashboardView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:AppsViewModel}">
                                    <views:AppsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:RobloxAccountsViewModel}">
                                    <views:RobloxAccountsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:PluginsViewModel}">
                                    <views:PluginsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:ScriptsViewModel}">
                                    <views:ScriptsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:DocsViewModel}">
                                    <views:DocsView />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                    <views:SettingsView />
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </Border>

                    <!-- Notification Panel Overlay -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="320" MaxHeight="400" Margin="0,4,8,0"
                            Background="{StaticResource MainBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            Visibility="{Binding NotificationPanelOpen, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="14,10">
                                <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <Button Content="Clear all" HorizontalAlignment="Right" Padding="8,3"
                                        Style="{StaticResource ControlButtonStyle}" FontSize="11"
                                        Command="{Binding ClearNotificationsCommand}" />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}"
                                     Style="{StaticResource DarkListBoxStyle}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch" MaxHeight="340">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Message}" FontSize="11"
                                                       Foreground="{StaticResource SubTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="10"
                                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
