<Window x:Class="Zyntra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zyntra"
        xmlns:vm="clr-namespace:Zyntra.ViewModels"
        xmlns:views="clr-namespace:Zyntra.Views"
        mc:Ignorable="d"
        Title="Zyntra" Icon="logo.ico" Height="650" Width="1000" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource MainBrush}" CornerRadius="10"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TopBrush}"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Zyntra" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text=" — " Foreground="{StaticResource SubTextBrush}" FontSize="13" />
                        <TextBlock Text="{Binding CurrentPageName}" Foreground="{StaticResource SubTextBrush}" FontSize="13" />
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="─" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeClick" />
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeClick" />
                        <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="CloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation -->
                        <StackPanel Grid.Row="0" Margin="0,8">
                            <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="18,8,0,8" Opacity="0.6" />

                            <Button x:Name="BtnApps" Content="⊞  Applications"
                                    Command="{Binding NavigateCommand}" CommandParameter="Apps"
                                    Click="SidebarNav_Click" Tag="Apps">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarActiveButtonStyle}" />
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnRoblox" Content="◉  Roblox Accounts"
                                    Command="{Binding NavigateCommand}" CommandParameter="Roblox"
                                    Click="SidebarNav_Click" Tag="Roblox">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnSteam" Content="🎮  Steam"
                                    Command="{Binding NavigateCommand}" CommandParameter="Steam"
                                    Click="SidebarNav_Click" Tag="Steam">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Footer -->
                        <StackPanel Grid.Row="1">
                            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                                <Button x:Name="BtnSettings" Content="⚙  Settings"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                        Click="SidebarNav_Click" Tag="Settings">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}" />
                                    </Button.Style>
                                </Button>
                            </Border>
                            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                                    Padding="14,10">
                                <TextBlock Text="Zyntra v1.0" FontSize="11"
                                           Foreground="{StaticResource SubTextBrush}" Opacity="0.5" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content -->
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}">
                    <ContentControl Content="{Binding CurrentPage}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:AppsViewModel}">
                                <views:AppsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:RobloxAccountsViewModel}">
                                <views:RobloxAccountsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SteamViewModel}">
                                <views:SteamView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <views:SettingsView />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
