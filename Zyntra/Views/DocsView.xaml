<UserControl x:Class="Zyntra.Views.DocsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels">
    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="8">
            <StackPanel>
                <TextBlock Text="API DOCS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                           Margin="8,6,0,8" />
                <Button x:Name="BtnOverview" Content="Overview" Padding="10,7"
                        Style="{StaticResource SidebarActiveButtonStyle}"
                        Click="OnDocNav" Tag="overview" />
                <Button x:Name="BtnLuaApi" Content="Lua API" Padding="10,7"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="OnDocNav" Tag="lua" />

                <TextBlock Text="EXTENSIONS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                           Margin="8,14,0,8" />
                <Button x:Name="BtnPlugins" Content="Plugin SDK" Padding="10,7"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="OnDocNav" Tag="plugins" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="2" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel x:Name="DocPanel" Margin="28,24,28,28" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
