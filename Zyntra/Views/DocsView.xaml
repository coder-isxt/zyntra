<UserControl x:Class="Zyntra.Views.DocsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels">
    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="8">
            <StackPanel>
                <TextBlock Text="API DOCS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                           Margin="8,6,0,8" />
                <Button x:Name="BtnOverview" Content="Overview" Padding="10,7"
                        Style="{StaticResource SidebarActiveButtonStyle}"
                        Click="OnDocNav" Tag="overview" />
                <Button x:Name="BtnPowerShell" Content="PowerShell API" Padding="10,7"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="OnDocNav" Tag="powershell" />
                <Button x:Name="BtnPython" Content="Python API" Padding="10,7"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="OnDocNav" Tag="python" />
                <Button x:Name="BtnBatch" Content="Batch Notes" Padding="10,7"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="OnDocNav" Tag="batch" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="2" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="24,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DocContent" FontFamily="Consolas" FontSize="13"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                           LineHeight="22" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
