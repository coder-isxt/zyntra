<UserControl x:Class="Zyntra.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Activity Log" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Track game launches and important events" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Padding="14,8"
                    Style="{StaticResource ControlButtonStyle}"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
            <Button Grid.Column="3" Content="Clear Log" Padding="14,8"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding ClearLogCommand}" VerticalAlignment="Top" />
        </Grid>

        <!-- Search -->
        <TextBox Grid.Row="2" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DarkTextBoxStyle}" Tag="🔍  Search activity..." FontSize="13" />

        <!-- Log Entries -->
        <ListBox Grid.Row="4" ItemsSource="{Binding FilteredEntries}"
                 Style="{StaticResource DarkListBoxStyle}"
                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Action badge -->
                        <Border Grid.Column="0" CornerRadius="4" Padding="8,3"
                                Background="{StaticResource ControlBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Action}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>

                        <!-- Details -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Details}" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                           Visibility="{Binding AccountName, Converter={StaticResource NonEmptyStringToVisConverter}}">
                                    <Run Text="{Binding AccountName, Mode=OneWay}" />
                                    <Run Text=" · " />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                           Visibility="{Binding PlaceName, Converter={StaticResource NonEmptyStringToVisConverter}}">
                                    <Run Text="{Binding PlaceName, Mode=OneWay}" />
                                    <Run Text=" · " />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="3" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding Timestamp, StringFormat='{}{0:MMM dd HH:mm}', Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <TextBlock Grid.Row="4" Text="No activity recorded yet. Launch a game or favorite a server to see entries here."
                   Foreground="{StaticResource SubTextBrush}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVisConverter}}" />
    </Grid>
</UserControl>
