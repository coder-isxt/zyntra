<UserControl x:Class="Zyntra.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Configure Zyntra preferences" FontSize="13"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Section -->
                <TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="0,0,0,10" />

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Launch on startup" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Automatically start Zyntra when Windows starts" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 IsChecked="{Binding LaunchOnStartup}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minimize to tray" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Minimize to system tray instead of closing" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 IsChecked="{Binding MinimizeToTray}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default page" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Page shown when Zyntra starts" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="140"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{x:Static vm:SettingsViewModel.PageOptions}"
                                  SelectedItem="{Binding DefaultPage}" />
                    </Grid>
                </Border>

                <!-- Appearance Section -->
                <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="0,20,0,10" />

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Accent Color" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Choose the accent color used throughout the app" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,10" />
                        <WrapPanel x:Name="AccentPanel" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Disable animations" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Turn off page transition animations" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 IsChecked="{Binding DisableAnimations}" />
                    </Grid>
                </Border>

                <!-- Accounts Section -->
                <TextBlock Text="ACCOUNTS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="0,20,0,10" />

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-refresh cookies" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Validate all account cookies when Zyntra starts" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 IsChecked="{Binding AutoRefreshCookies}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default tag for new accounts" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Automatically assign this tag when adding accounts" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="140" VerticalAlignment="Center"
                                 Style="{StaticResource DarkTextBoxStyle}" Tag="e.g. alt"
                                 Text="{Binding DefaultTag, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hide invalid accounts" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Hide accounts with expired cookies from the list" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 IsChecked="{Binding HideInvalidAccounts}" />
                    </Grid>
                </Border>

                <!-- Scripting Section -->
                <TextBlock Text="SCRIPTING" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="0,20,0,10" />

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Default script template" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Content used when creating a new script" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,8" />
                        <TextBox Style="{StaticResource DarkTextBoxStyle}" Tag="Lua template"
                                 Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Text="{Binding DefaultScriptTemplate, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Border>

                <!-- Data Section -->
                <TextBlock Text="DATA" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="0,20,0,10" />

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Account Backup" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Export or import your Roblox accounts (encrypted .zyntra file)" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Export" Padding="14,7"
                                Style="{StaticResource ControlButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding ExportAccountsCommand}" />
                        <Button Grid.Column="3" Content="Import" Padding="14,7"
                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding ImportAccountsCommand}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Clear recently played" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Wipe all recently played game history" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear" Padding="14,7"
                                Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding ClearRecentlyPlayedCommand}" />
                    </Grid>
                </Border>

                <!-- Updates Section -->
                <TextBlock Text="UPDATES" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="0,20,0,10" />

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Check on startup" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Automatically check for updates when Zyntra starts" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                 Style="{StaticResource ToggleSwitchStyle}"
                                 IsChecked="{Binding CheckForUpdatesOnStartup}" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Check for Updates" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding UpdateStatus, FallbackValue='Click to check for the latest version'}"
                                       FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Check Now" Padding="14,7"
                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolToVisConverter}}" />
                    </Grid>
                </Border>

                <!-- About Section -->
                <TextBlock Text="ABOUT" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="0,20,0,10" />

                <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="AboutVersionText" FontSize="13" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="A universal app launcher and Roblox account manager."
                                   FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
