<Window x:Class="Zyntra.Views.SteamGamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch Steam Game" Height="180" Width="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border Background="{StaticResource MainBrush}" CornerRadius="10"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Launch Steam Game" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />

            <TextBox x:Name="AppIdInput" Grid.Row="2"
                     Style="{StaticResource DarkTextBoxStyle}" Tag="Steam App ID (e.g. 730)"
                     FontSize="13" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource ControlButtonStyle}"
                        Click="OnCancelClick" Padding="14,8" Margin="0,0,8,0" />
                <Button Content="Launch" Style="{StaticResource AccentButtonStyle}"
                        Click="OnLaunchClick" Padding="20,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
