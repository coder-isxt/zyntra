<UserControl x:Class="Zyntra.Views.RobloxAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Roblox Accounts" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Manage your Roblox accounts and launch with any of them" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Add Account Section -->
        <Border Grid.Row="2" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Add Account" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CookieInput" Grid.Column="0"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Tag="Paste .ROBLOSECURITY cookie here..."
                             FontFamily="Consolas" FontSize="12" />
                    <Button Grid.Column="2" Content="Add Cookie" Style="{StaticResource ControlButtonStyle}"
                            Click="OnAddAccountClick" />
                    <Button Grid.Column="4" Content="🌐 Browser Login" Style="{StaticResource AccentButtonStyle}"
                            Click="OnBrowserLoginClick" />
                </Grid>
            </Grid>
        </Border>

        <!-- Account List -->
        <ListBox Grid.Row="4" ItemsSource="{Binding Accounts}"
                 SelectedItem="{Binding SelectedAccount}"
                 Style="{StaticResource DarkListBoxStyle}"
                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Circle -->
                        <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                            <!-- Fallback letter -->
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{StaticResource AccentBrush}">
                                <TextBlock Text="{Binding DisplayName[0]}" FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0D1117"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Profile picture -->
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Visibility="{Binding AvatarUrl, Converter={StaticResource NonEmptyToVisConverter}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Account Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0">
                                <Run Text="@" /><Run Text="{Binding Username, Mode=OneWay}" />
                                <Run Text=" · ID: " /><Run Text="{Binding UserId, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Launch -->
                        <Button Grid.Column="2" Content="▶ Launch" Padding="14,7"
                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding DataContext.LaunchRobloxCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />

                        <!-- Refresh -->
                        <Button Grid.Column="4" Content="↻" FontSize="16" Padding="8,5"
                                Style="{StaticResource ControlButtonStyle}" VerticalAlignment="Center"
                                ToolTip="Refresh account info"
                                Command="{Binding DataContext.RefreshAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />

                        <!-- Remove -->
                        <Button Grid.Column="6" Content="✕" FontSize="14" Padding="8,5"
                                Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"
                                ToolTip="Remove account"
                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <TextBlock Grid.Row="4" Text="No accounts added yet. Paste a .ROBLOSECURITY cookie above to add one."
                   Foreground="{StaticResource SubTextBrush}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Accounts.Count, Converter={StaticResource ZeroToVisConverter}}" />

        <!-- Status Bar -->
        <Border Grid.Row="5" Margin="0,12,0,0" Padding="0,8,0,0"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                <TextBlock Text="Loading..." Foreground="{StaticResource AccentBrush}" FontSize="12"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
