<UserControl x:Class="Zyntra.Views.RobloxAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Roblox Accounts" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Manage your Roblox accounts and launch with any of them" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Add Account Section -->
        <Border Grid.Row="2" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Add Account" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CookieInput" Grid.Column="0"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Tag="Paste .ROBLOSECURITY cookie here..."
                             FontFamily="Consolas" FontSize="12" />
                    <Button Grid.Column="2" Content="Add Cookie" Style="{StaticResource ControlButtonStyle}"
                            Click="OnAddAccountClick" />
                    <Button Grid.Column="4" Content="🌐 Browser Login" Style="{StaticResource AccentButtonStyle}"
                            Click="OnBrowserLoginClick" />
                </Grid>
            </Grid>
        </Border>

        <!-- Tag Filter & Health Check Bar -->
        <Border Grid.Row="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Filter:" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableTags}"
                          SelectedItem="{Binding SelectedTag}"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Width="140" HorizontalAlignment="Left" />
                <Button Grid.Column="4" Content="🔍 Check Health" Padding="12,6"
                        Style="{StaticResource ControlButtonStyle}" VerticalAlignment="Center"
                        Command="{Binding CheckHealthCommand}" ToolTip="Validate all cookies" />
            </Grid>
        </Border>

        <!-- Account List -->
        <ListBox Grid.Row="6" ItemsSource="{Binding FilteredAccounts}"
                 SelectedItem="{Binding SelectedAccount}"
                 Style="{StaticResource DarkListBoxStyle}"
                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            Padding="14,10" Margin="0,2">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Launch"
                                          Command="{Binding DataContext.LaunchRobloxCommand, Source={x:Reference AccountListRef}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Set Tag"
                                          Command="{Binding DataContext.SetTagCommand, Source={x:Reference AccountListRef}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Refresh Info"
                                          Command="{Binding DataContext.RefreshAccountCommand, Source={x:Reference AccountListRef}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Copy Username" Click="OnCopyUsername" />
                                <MenuItem Header="Copy User ID" Click="OnCopyUserId" />
                                <Separator />
                                <MenuItem Header="Remove Account"
                                          Command="{Binding DataContext.RemoveAccountCommand, Source={x:Reference AccountListRef}}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar with health dot -->
                            <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource AccentBrush}">
                                    <TextBlock Text="{Binding DisplayName[0]}" FontSize="17" FontWeight="Bold"
                                               Foreground="#FF0D1117"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="40" Height="40" CornerRadius="20"
                                        Visibility="{Binding AvatarUrl, Converter={StaticResource NonEmptyToVisConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Stroke="#FF171A22" StrokeThickness="2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF6B6B6B" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CookieValid}" Value="True">
                                                    <Setter Property="Fill" Value="#FF6BCB77" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CookieValid}" Value="False">
                                                    <Setter Property="Fill" Value="#FFFF6B6B" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <!-- Account Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            Background="{StaticResource ControlHoverBrush}"
                                            Visibility="{Binding Tag, Converter={StaticResource NonEmptyToVisConverter}}">
                                        <TextBlock Text="{Binding Tag}" FontSize="10"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0">
                                    <Run Text="@" /><Run Text="{Binding Username, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding UserId, Mode=OneWay}" />
                                </TextBlock>
                                <!-- Notes preview -->
                                <TextBlock Text="{Binding Notes}" FontSize="10.5" FontStyle="Italic"
                                           Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400"
                                           HorizontalAlignment="Left"
                                           Visibility="{Binding Notes, Converter={StaticResource NonEmptyToVisConverter}}" />
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="▶ Launch" Padding="14,7"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding DataContext.LaunchRobloxCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                <Button Content="🏷" FontSize="14" Padding="8,5"
                                        Style="{StaticResource ControlButtonStyle}" ToolTip="Set tag"
                                        Command="{Binding DataContext.SetTagCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                <Button Content="↻" FontSize="16" Padding="8,5"
                                        Style="{StaticResource ControlButtonStyle}" ToolTip="Refresh"
                                        Command="{Binding DataContext.RefreshAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                <Button Content="✕" FontSize="14" Padding="8,5"
                                        Style="{StaticResource DangerButtonStyle}" ToolTip="Remove"
                                        Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Hidden element for x:Reference in ContextMenu bindings -->
        <FrameworkElement x:Name="AccountListRef" Visibility="Collapsed"
                          DataContext="{Binding}" Grid.Row="6" />

        <!-- Empty state -->
        <TextBlock Grid.Row="6" Text="No accounts added yet. Paste a .ROBLOSECURITY cookie above to add one."
                   Foreground="{StaticResource SubTextBrush}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding FilteredAccounts.Count, Converter={StaticResource ZeroToVisConverter}}" />

        <!-- Status Bar -->
        <Border Grid.Row="7" Margin="0,12,0,0" Padding="0,8,0,0"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                <TextBlock Text="Loading..." Foreground="{StaticResource AccentBrush}" FontSize="12"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
