<UserControl x:Class="Zyntra.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scripts" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Create and run automation scripts" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Script" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding NewScriptCommand}" VerticalAlignment="Top" Padding="16,8" />
            <Button Grid.Column="3" Content="Save" Style="{StaticResource ControlButtonStyle}"
                    Command="{Binding SaveScriptsCommand}" VerticalAlignment="Top" Padding="16,8" />
        </Grid>

        <!-- Main Content: Split Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Script List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <Grid>
                        <ListBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                                 Style="{StaticResource DarkListBoxStyle}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                Background="{StaticResource ControlBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="Lua" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                    Visibility="{Binding Scripts.Count, Converter={StaticResource ZeroToVisConverter}}">
                            <TextBlock Text="No scripts yet" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Click '+ New Script' to create one" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Editor Panel -->
            <Grid Grid.Column="2">
                <!-- Shown when a script is selected -->
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="1*" MinHeight="80" />
                    </Grid.RowDefinitions>

                    <!-- Script toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Tag="Script name" />
                            <Button Grid.Column="2" Content="▶  Run" Padding="18,8"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding RunScriptCommand}" />
                            <Button Grid.Column="4" Content="Delete" Padding="12,8" FontSize="12"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteScriptCommand}" />
                        </Grid>
                    </Border>

                    <!-- Code Editor -->
                    <Border Grid.Row="2" Background="#FF0D1117" CornerRadius="8"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Editor header bar -->
                            <Border Grid.Row="0" Background="#FF161B22"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#30709BFF" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Lua" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding EditorName}" FontSize="10"
                                               Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Line numbers + editor -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Line numbers gutter -->
                                <Border Grid.Column="0" Background="#FF0D1117"
                                        BorderBrush="#FF1E2430" BorderThickness="0,0,1,0"
                                        MinWidth="40">
                                    <ScrollViewer x:Name="LineNumberScroll"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  IsHitTestVisible="False">
                                        <TextBlock x:Name="LineNumbers" FontFamily="Consolas" FontSize="13"
                                                   Foreground="#FF484F5E" Padding="10,8,10,8"
                                                   TextAlignment="Right" />
                                    </ScrollViewer>
                                </Border>

                                <!-- Syntax highlight layer (read-only, behind) -->
                                <ScrollViewer x:Name="HighlightScroll" Grid.Column="1"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Hidden"
                                              IsHitTestVisible="False">
                                    <RichTextBox x:Name="HighlightLayer"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="8,8,14,8" IsReadOnly="True" IsHitTestVisible="False"
                                                 FontFamily="Consolas" FontSize="13"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 VerticalScrollBarVisibility="Disabled">
                                        <RichTextBox.Resources>
                                            <Style TargetType="Paragraph">
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </RichTextBox.Resources>
                                    </RichTextBox>
                                </ScrollViewer>

                                <!-- Code text box (transparent text, on top) -->
                                <TextBox x:Name="CodeEditor" Grid.Column="1"
                                         Text="{Binding EditorContent, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="Transparent"
                                         CaretBrush="#FFC9D1D9" SelectionBrush="{StaticResource AccentBrush}"
                                         BorderThickness="0" Padding="8,8,14,8"
                                         FontFamily="Consolas" FontSize="13"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         TextChanged="CodeEditor_TextChanged"
                                         ScrollViewer.ScrollChanged="CodeEditor_ScrollChanged"
                                         PreviewKeyDown="CodeEditor_PreviewKeyDown" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Output Label -->
                    <TextBlock Grid.Row="4" Text="OUTPUT" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource SubTextBrush}" Opacity="0.6" Margin="2,0" />

                    <!-- Output -->
                    <Border Grid.Row="6" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="12,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Output}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource SubTextBrush}" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Empty state when no script selected -->
                <Border Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisConverter}}"
                        Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No script selected" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a script from the list, or create a new one to get started."
                                   FontSize="13" Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,8,0,0"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
