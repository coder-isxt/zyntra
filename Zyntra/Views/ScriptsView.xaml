<UserControl x:Class="Zyntra.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scripts" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Create and run automation scripts" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Script" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding NewScriptCommand}" VerticalAlignment="Top" Padding="16,8" />
            <Button Grid.Column="3" Content="Save" Style="{StaticResource ControlButtonStyle}"
                    Command="{Binding SaveScriptsCommand}" VerticalAlignment="Top" Padding="16,8" />
        </Grid>

        <!-- Main Content: Split Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Script List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <Grid>
                        <ListBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                                 Style="{StaticResource DarkListBoxStyle}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Run" Click="OnContextRunScript" />
                                                <MenuItem Header="Duplicate" Click="OnContextDuplicateScript" />
                                                <Separator />
                                                <MenuItem Header="Delete" Click="OnContextDeleteScript" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                                Background="{StaticResource ControlBrush}" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconScripts}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="9.5" Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                                       Visibility="{Binding SchedulerEnabled, Converter={StaticResource BoolToVisConverter}}">
                                                <Run Text="⏱ Every " /><Run Text="{Binding SchedulerIntervalMinutes, Mode=OneWay}" /><Run Text="m" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                    Visibility="{Binding Scripts.Count, Converter={StaticResource ZeroToVisConverter}}">
                            <TextBlock Text="No scripts yet" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Click '+ New Script' to create one" FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Editor Panel -->
            <Grid Grid.Column="2">
                <!-- Shown when a script is selected -->
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="2.5*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="1*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!-- Script toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}" Tag="Script name"
                                         FontSize="13" />
                                <Button Grid.Column="2" Padding="18,8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding RunScriptCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M5 3l14 9-14 9V3z" Fill="#FF0D1117"
                                              Width="10" Height="10" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="Run" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Content="Delete" Padding="14,8" FontSize="12"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteScriptCommand}" />
                            </Grid>
                            <!-- Scheduler row -->
                            <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
                                    Background="{StaticResource PanelBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⏱" FontSize="13"
                                               Foreground="{StaticResource AccentBrush}" Opacity="0.8"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Run on schedule" FontSize="12"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="4" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding SchedulerEnabled}" />
                                    <TextBlock Grid.Column="6" Text="every" FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="8"
                                             Text="{Binding SchedulerInterval, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" FontSize="11"
                                             TextAlignment="Center"
                                             IsEnabled="{Binding SchedulerEnabled}" />
                                    <TextBlock Grid.Column="10" Text="minutes" FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Code Editor -->
                    <Border Grid.Row="2" Background="#FF0D1117" CornerRadius="8"
                            BorderBrush="#FF1E2430" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Editor tab bar -->
                            <Border Grid.Row="0" Background="#FF161B22" Padding="0">
                                <Grid>
                                    <!-- Tab row -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#FF0D1117" Padding="12,7,12,7"
                                                BorderBrush="#FF1E2430" BorderThickness="0,0,1,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock FontSize="11" VerticalAlignment="Center">
                                                    <Run Text="{Binding EditorName, Mode=OneWay}"
                                                         Foreground="{StaticResource TextBrush}" />
                                                    <Run Text=".lua" Foreground="{StaticResource SubTextBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- Language badge on the right -->
                                    <Border Background="#20709BFF" CornerRadius="3" Padding="8,3"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="Lua" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- AvalonEdit Code Editor -->
                            <avalonedit:TextEditor x:Name="CodeEditor" Grid.Row="1"
                                                   FontFamily="Cascadia Code,Consolas,Courier New"
                                                   FontSize="13"
                                                   ShowLineNumbers="True"
                                                   Background="#FF0D1117"
                                                   Foreground="#FFD4D4D4"
                                                   Padding="6,6,6,6"
                                                   WordWrap="False"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <!-- Output Header -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="2,0" />
                            <Border Background="{StaticResource ControlBrush}" CornerRadius="8"
                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="running…" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear" Padding="10,3" FontSize="10"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="OnClearOutputClick" />
                    </Grid>

                    <!-- Output -->
                    <Border Grid.Row="6" Background="#FF0D1117" CornerRadius="8"
                            BorderBrush="#FF1E2430" BorderThickness="1" Padding="14,12">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding Output}" FontFamily="Cascadia Code,Consolas,Courier New"
                                           FontSize="12" Foreground="#FFABB2BF" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding Output, Converter={StaticResource EmptyStringToVisConverter}}">
                                <TextBlock Text="No output yet" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubTextBrush}" Opacity="0.5"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Run a script to see results here" FontSize="10"
                                           Foreground="{StaticResource SubTextBrush}" Opacity="0.35"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Empty state when no script selected -->
                <Border Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisConverter}}"
                        Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No script selected" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a script from the list, or create a new one to get started."
                                   FontSize="13" Foreground="{StaticResource SubTextBrush}" Opacity="0.6"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,8,0,0"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
