<UserControl x:Class="Zyntra.Views.YouTubePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- YouTube-style top bar -->
        <Border Grid.Row="0" Background="{StaticResource MainBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="24" CornerRadius="6" Background="#FFFF0033">
                        <Path Data="M10 6l12 6-12 6V6z" Fill="White"
                              Width="16" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="YouTube" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Height="38" CornerRadius="19"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Background="{StaticResource PanelInsetBrush}" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding VideoInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Tag="Search or paste a YouTube link"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 Padding="16,7" />
                        <Button Grid.Column="1" ToolTip="Load video"
                                Command="{Binding LoadVideoCommand}"
                                Style="{StaticResource ControlButtonStyle}"
                                Padding="0" BorderThickness="1,0,0,0">
                            <Path Data="M21 21l-4.35-4.35 M10 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="4" Style="{StaticResource ControlButtonStyle}"
                        Command="{Binding OpenPipCommand}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPictureInPicture}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="PiP" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" Content="Stop"
                        Style="{StaticResource ControlButtonStyle}"
                        Command="{Binding StopCommand}" Padding="12,8" />
            </Grid>
        </Border>

        <!-- Watch page -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Player -->
                    <Border Background="#FF0D1117" CornerRadius="8"
                            BorderBrush="#FF1E2430" BorderThickness="1"
                            ClipToBounds="True" MinHeight="360">
                        <Grid>
                            <wv2:WebView2 x:Name="PlayerWebView"
                                          MinHeight="360"
                                          DefaultBackgroundColor="#0D1117" />

                            <Border x:Name="EmptyOverlay" Background="#FF0D1117">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconVideo}"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2" StrokeLineJoin="Round"
                                          Width="52" Height="52" Stretch="Uniform"
                                          HorizontalAlignment="Center" Opacity="0.85" />
                                    <TextBlock Text="Paste a YouTube link to start watching"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource SubTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Video info / actions -->
                    <Grid Margin="0,14,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentTitle, FallbackValue='No video loaded'}"
                                       FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentVideoId}" FontSize="12"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Save to playlist" Padding="14,8"
                                    Style="{StaticResource ControlButtonStyle}"
                                    Command="{Binding AddCurrentToPlaylistCommand}" />
                            <Button Content="Clear history" Padding="14,8" Margin="8,0,0,0"
                                    Style="{StaticResource ControlButtonStyle}"
                                    Command="{Binding ClearHistoryCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Continue shelf -->
                    <TextBlock Text="Continue watching" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,20">
                        <ItemsControl ItemsSource="{Binding ContinueWatching}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="210" Margin="0,0,12,0" Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="118" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{StaticResource PanelInsetBrush}"
                                                    CornerRadius="8" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                                                 Height="4" VerticalAlignment="Bottom" />
                                                    <Button Content="Resume" Padding="10,4"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="8"
                                                            Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" MaxHeight="36" />
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                           Foreground="{StaticResource SubTextBrush}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- History shelf -->
                    <TextBlock Text="Watch history" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                                        Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailUrl}" Width="128" Height="72"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                       Foreground="{StaticResource SubTextBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="Play" Padding="12,6"
                                                Style="{StaticResource ControlButtonStyle}"
                                                Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Right rail -->
            <Border Grid.Column="2" Background="{StaticResource MainBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="Playlists" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />

                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Tag="New playlist"
                                     FontSize="12" />
                            <Button Grid.Column="2" Content="Create" Padding="10,7"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding CreatePlaylistCommand}" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                                  DisplayMemberPath="Name" Style="{StaticResource DarkComboBoxStyle}"
                                  Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Add current" Padding="10,7"
                                    Style="{StaticResource ControlButtonStyle}"
                                    Command="{Binding AddCurrentToPlaylistCommand}" />
                            <Button Grid.Column="2" Content="Delete" Padding="10,7"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeletePlaylistCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SelectedPlaylistItems}" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                                            Padding="8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailUrl}" Width="96" Height="54"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" MaxHeight="34" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="Play" Padding="8,4" FontSize="10"
                                                            Style="{StaticResource ControlButtonStyle}"
                                                            Command="{Binding DataContext.PlayPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remove" Padding="8,4" FontSize="10"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemovePlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Up next" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding ThumbnailUrl}" Width="96" Height="54"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap" MaxHeight="34" />
                                            <Button Content="Play" Padding="8,4" FontSize="10"
                                                    Style="{StaticResource ControlButtonStyle}"
                                                    Margin="0,6,0,0" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource MainBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                Padding="18,8">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
