<UserControl x:Class="Zyntra.Views.YouTubePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="TopIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="RailActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource MainBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="22" CornerRadius="6" Background="#FFFF0033">
                        <Path Data="M10 6l12 6-12 6V6z" Fill="White"
                              Width="15" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="YouTube" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Height="38" MaxWidth="560" CornerRadius="19"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Background="{StaticResource PanelInsetBrush}"
                        VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding VideoInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Tag="Search or paste a YouTube link"
                                 BorderThickness="0"
                                 Background="{StaticResource PanelInsetBrush}"
                                 FontSize="13"
                                 Height="36"
                                 Padding="14,7" />
                        <Button Grid.Column="1" ToolTip="Load video"
                                Command="{Binding LoadVideoCommand}"
                                Style="{StaticResource TopIconButtonStyle}"
                                BorderThickness="1,0,0,0"
                                Padding="0">
                            <Path Data="M21 21l-4.35-4.35 M10 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="4" Style="{StaticResource TopIconButtonStyle}"
                        Command="{Binding OpenPipCommand}" ToolTip="Picture in picture">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPictureInPicture}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="PiP" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" Content="Stop"
                        Style="{StaticResource TopIconButtonStyle}"
                        Command="{Binding StopCommand}" />
            </Grid>
        </Border>

        <!-- Main Watch Surface -->
        <Grid Grid.Row="1" Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: Player + shelves -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.6*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF0D1117" CornerRadius="8"
                        BorderBrush="#FF1E2430" BorderThickness="1"
                        ClipToBounds="True" MinHeight="240">
                    <Grid>
                        <wv2:WebView2 x:Name="PlayerWebView"
                                      DefaultBackgroundColor="#0D1117" />

                        <Border x:Name="EmptyOverlay" Background="#FF0D1117">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconVideo}"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      Width="48" Height="48" Stretch="Uniform"
                                      HorizontalAlignment="Center" Opacity="0.85" />
                                <TextBlock Text="Paste a YouTube link to start watching"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTitle, FallbackValue='No video loaded'}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentVideoId}" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Save" Height="32" Padding="14,0"
                                Style="{StaticResource ControlButtonStyle}"
                                Command="{Binding AddCurrentToPlaylistCommand}" />
                        <Button Content="Clear history" Height="32" Padding="14,0" Margin="8,0,0,0"
                                Style="{StaticResource ControlButtonStyle}"
                                Command="{Binding ClearHistoryCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Continue watching" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,9" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding ContinueWatching}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="190" Margin="0,0,12,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="106" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{StaticResource PanelInsetBrush}"
                                                        CornerRadius="7" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                                                     Height="4" VerticalAlignment="Bottom" />
                                                        <Button Content="Resume" Padding="9,3" FontSize="10"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="7"
                                                                Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" MaxHeight="34" />
                                                    <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                               Foreground="{StaticResource SubTextBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="Watch history" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,9" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                                            Padding="9" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailUrl}" Width="112" Height="63"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProgressText}" FontSize="10.5"
                                                           Foreground="{StaticResource SubTextBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="Play" Height="30"
                                                    Padding="12,0"
                                                    Style="{StaticResource ControlButtonStyle}"
                                                    Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right Rail -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource MainBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Playlists" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />

                        <Grid Margin="0,10,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Tag="New playlist"
                                     Height="34" FontSize="12" Padding="10,6" />
                            <Button Grid.Column="2" Content="Create" Width="64"
                                    Style="{StaticResource RailActionButtonStyle}"
                                    Command="{Binding CreatePlaylistCommand}" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                                  DisplayMemberPath="Name" Style="{StaticResource DarkComboBoxStyle}"
                                  Height="32" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Add current" Style="{StaticResource RailActionButtonStyle}"
                                    Command="{Binding AddCurrentToPlaylistCommand}" />
                            <Button Grid.Column="2" Content="Delete" Width="64"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Height="30" Padding="10,0" FontSize="11"
                                    Command="{Binding DeletePlaylistCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource MainBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Selected playlist" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding SelectedPlaylistItems}" Margin="0,0,0,18">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="9" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailUrl}" Width="92" Height="52"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" MaxHeight="33" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Button Content="Play" Style="{StaticResource RailActionButtonStyle}"
                                                            Height="24" Padding="8,0" FontSize="10"
                                                            Command="{Binding DataContext.PlayPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remove" Style="{StaticResource DangerButtonStyle}"
                                                            Height="24" Padding="8,0" FontSize="10"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemovePlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Up next" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="9" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding ThumbnailUrl}" Width="92" Height="52"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" MaxHeight="33" />
                                                <Button Content="Play" Style="{StaticResource RailActionButtonStyle}"
                                                        Height="24" Padding="8,0" FontSize="10"
                                                        Margin="0,5,0,0" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource MainBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                Padding="18,7">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
