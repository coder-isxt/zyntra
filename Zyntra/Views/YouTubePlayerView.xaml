<UserControl x:Class="Zyntra.Views.YouTubePlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="YouTube" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Watch, resume, and organize videos locally" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelInsetBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" VerticalAlignment="Top">
                <TextBlock Text="Local library" Foreground="{StaticResource SubTextBrush}" FontSize="11" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding VideoInput, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Tag="YouTube link or video ID"
                     FontSize="13" />

            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding LoadVideoCommand}" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M5 3l14 9-14 9V3z" Fill="#FF0D1117"
                          Width="10" Height="10" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="Load" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource ControlButtonStyle}"
                    Command="{Binding OpenPipCommand}" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPictureInPicture}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeLineJoin="Round"
                          Width="14" Height="14" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="PiP" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="6" Content="Stop"
                    Style="{StaticResource ControlButtonStyle}"
                    Command="{Binding StopCommand}" Padding="14,8" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF0D1117" CornerRadius="8"
                    BorderBrush="#FF1E2430" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="PlayerWebView"
                                  DefaultBackgroundColor="#0D1117" />

                    <Border x:Name="EmptyOverlay" Background="#FF0D1117">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconVideo}"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"
                                  Width="46" Height="46" Stretch="Uniform"
                                  HorizontalAlignment="Center" Opacity="0.8" />
                            <TextBlock Text="No video loaded" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelInsetBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="CONTINUE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.65" />
                        <ItemsControl ItemsSource="{Binding ContinueWatching}" Margin="0,8,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6"
                                            Padding="8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding ThumbnailUrl}"
                                                   Width="76" Height="43" Stretch="UniformToFill" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                                             Height="4" Margin="0,6,0,3" />
                                                <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                           Foreground="{StaticResource SubTextBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="Play" Padding="8,4" FontSize="10"
                                                    Style="{StaticResource ControlButtonStyle}"
                                                    Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <TextBlock Text="HISTORY" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SubTextBrush}" Opacity="0.65" />
                            <Button Content="Clear" HorizontalAlignment="Right" Padding="8,3" FontSize="10"
                                    Style="{StaticResource ControlButtonStyle}"
                                    Command="{Binding ClearHistoryCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding History}" MaxHeight="210" Margin="0,8,0,16"
                                 Style="{StaticResource DarkListBoxStyle}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                       Foreground="{StaticResource SubTextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Play" Padding="8,4" FontSize="10"
                                                Style="{StaticResource ControlButtonStyle}"
                                                Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="PLAYLISTS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource SubTextBrush}" Opacity="0.65" />
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Tag="New playlist"
                                     FontSize="12" />
                            <Button Grid.Column="2" Content="Create" Padding="10,7" FontSize="11"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding CreatePlaylistCommand}" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}"
                                  DisplayMemberPath="Name" Style="{StaticResource DarkComboBoxStyle}"
                                  Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Add current video" Padding="10,7" FontSize="11"
                                    Style="{StaticResource ControlButtonStyle}"
                                    Command="{Binding AddCurrentToPlaylistCommand}" />
                            <Button Grid.Column="2" Content="Delete playlist" Padding="10,7" FontSize="11"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeletePlaylistCommand}" />
                        </Grid>

                        <ListBox ItemsSource="{Binding SelectedPlaylistItems}" MaxHeight="210"
                                 Style="{StaticResource DarkListBoxStyle}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Play" Padding="8,4" FontSize="10"
                                                Style="{StaticResource ControlButtonStyle}"
                                                Command="{Binding DataContext.PlayPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Content="x" Padding="8,4" FontSize="10"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.RemovePlaylistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="5" Margin="0,10,0,0" Padding="0,8,0,0"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
