<UserControl x:Class="Zyntra.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zyntra.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Applications" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Manage your built-in and custom applications" FontSize="13"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ Add App" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding AddAppCommand}" VerticalAlignment="Top" />
        </Grid>

        <!-- Search Bar -->
        <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DarkTextBoxStyle}" Tag="🔍  Search applications..."
                 FontSize="13" />

        <!-- App List -->
        <ListBox Grid.Row="4" ItemsSource="{Binding FilteredApps}"
                 SelectedItem="{Binding SelectedApp}"
                 Style="{StaticResource DarkListBoxStyle}"
                 ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                            <!-- Fallback letter -->
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{StaticResource ControlBrush}">
                                <TextBlock Text="{Binding Name[0]}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Custom icon (if IconPath set) -->
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource ControlBrush}" Padding="4"
                                    Visibility="{Binding IconPath, Converter={StaticResource ExeHasIconVis}}">
                                <Image Source="{Binding IconPath, Converter={StaticResource ExeIconConverter}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <!-- Exe icon (if no custom icon) -->
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource ControlBrush}" Padding="4"
                                    Visibility="{Binding IconPath, Converter={StaticResource ExeNoIconVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExePath, Converter={StaticResource ExeHasIconVis}}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding ExePath, Converter={StaticResource ExeIconConverter}}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <!-- Name + Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <Border Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisConverter}}"
                                        Background="{StaticResource AccentBrush}" CornerRadius="4"
                                        Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Built-in" FontSize="10" FontWeight="Bold" Foreground="#FF0D1117" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="12"
                                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Launch -->
                        <Button Grid.Column="2" Content="Launch"
                                Style="{StaticResource AccentButtonStyle}" Padding="14,7"
                                Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" VerticalAlignment="Center" />

                        <!-- Settings -->
                        <Button Grid.Column="4" Content="⚙" FontSize="15" Padding="8,5"
                                Style="{StaticResource ControlButtonStyle}" VerticalAlignment="Center"
                                ToolTip="App settings"
                                Command="{Binding DataContext.EditAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />

                        <!-- Move Up -->
                        <Button Grid.Column="6" Content="▲" FontSize="10" Padding="6,4"
                                Style="{StaticResource ControlButtonStyle}" VerticalAlignment="Center"
                                ToolTip="Move up"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />

                        <!-- Move Down -->
                        <Button Grid.Column="8" Content="▼" FontSize="10" Padding="6,4"
                                Style="{StaticResource ControlButtonStyle}" VerticalAlignment="Center"
                                ToolTip="Move down"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />

                        <!-- Remove -->
                        <Button Grid.Column="10"
                                Content="✕" FontSize="14" Padding="8,4"
                                Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"
                                ToolTip="Remove app"
                                Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <TextBlock Grid.Row="4" Text="No applications found. Click '+ Add App' to get started."
                   Foreground="{StaticResource SubTextBrush}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Apps.Count, Converter={StaticResource ZeroToVisConverter}}" />
    </Grid>
</UserControl>
